{
  "DatabaseProvider": "PostgreSQL",
  "ConnectionStrings": {
    "DefaultConnection": "${DATABASE_URL}",
    "SMPPIDatabase": "${DATABASE_URL}"
  },
  "DashboardSettings": {
    "ItemsPerPage": 20,
    "CacheDurationMinutes": 15,
    "MaxExportRecords": 10000,
    "EnableAuditLog": true,
    "DateTimeZone": "Singapore Standard Time",
    "CurrencySymbol": "RM",
    "DecimalPlaces": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
